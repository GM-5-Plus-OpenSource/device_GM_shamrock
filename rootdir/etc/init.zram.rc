on early-init
    write /sys/block/zram0/comp_algorithm lz4

on post-fs-data
    # --- ZRAM RESET ---
    write /sys/block/zram0/reset 1

    # --- COMPRESSION ---
    write /sys/block/zram0/comp_algorithm lz4

    # --- 1.25GB ZRAM ---
    write /sys/block/zram0/disksize 1342177280

    # --- SWAP ENABLE ---
    mkswap /dev/block/zram0
    swapon /dev/block/zram0 priority 32758

    # --- VM TUNING ---
    write /proc/sys/vm/swappiness 60
    write /proc/sys/vm/page-cluster 0
    write /proc/sys/vm/dirty_ratio 20
    write /proc/sys/vm/dirty_background_ratio 5
    write /proc/sys/vm/vfs_cache_pressure 50

    # --- LOWMEMORYKILLER ---
    write /sys/module/lowmemorykiller/parameters/adj "0,58,117,176,235,294"
    write /sys/module/lowmemorykiller/parameters/minfree "18432,23040,27648,32256,55296,80640"

    # --- KSWAPD / MEMORY RECLAIM ---
    write /proc/sys/vm/watermark_scale_factor 125
    write /proc/sys/vm/extfrag_threshold 750

    # --- I/O TUNING ---
    write /sys/block/mmcblk0/queue/read_ahead_kb 128